    "lint": "eslint src"
  },
  "dependencies": {
    "@crashing/plugin-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": {
      "types": "./src/styles.d.ts",
      "default": "./src/panel.css"
    },
    "./opening-thumbnails": "./src/opening-thumbnails.ts",
    "./thumbnails": "./src/thumbnails.ts"
