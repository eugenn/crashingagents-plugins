{
  "name": "@crashing/panel-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external react --external react-dom",
    "typecheck": "tsc --noEmit",
