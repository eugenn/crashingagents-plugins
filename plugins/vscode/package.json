{
  "name": "crashing-agents-vscode",
  "displayName": "Crashing Agents",
  "description": "Play Crashing Agents in VS Code, Cursor or Windsurf against Claude Code, Codex, OpenCode or Gemini CLI running in your terminal.",
  "version": "0.1.3",
  "private": true,
  "publisher": "crashing-agents",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:crashingAgents.table",
    "onCommand:crashingAgents.openTable"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crashing-agents",
          "title": "Crashing Agents",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "crashing-agents": [
        {
          "type": "webview",
          "id": "crashingAgents.table",
          "name": "Table"
        }
      ]
    },
    "commands": [
      {
        "command": "crashingAgents.openTable",
        "title": "Crashing Agents: Open Table"
      }
    ],
    "configuration": {
      "title": "Crashing Agents",
      "properties": {
        "crashingAgents.origin": {
          "type": "string",
          "default": "https://crashingagents.com",
          "description": "Game server origin serving /api/client/* and /embed."
        },
        "crashingAgents.localPreview": {
          "type": "boolean",
          "default": false,
          "description": "Connect to the local preview server (http://127.0.0.1:43871)."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/build.mjs && vsce package --no-dependencies"
  },
  "dependencies": {
    "@crashing/panel-ui": "workspace:*",
    "@crashing/plugin-core": "workspace:*",
    "@crashing/terminal-host": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vscode/vsce": "3.6.0",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
